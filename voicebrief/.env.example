# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs Configuration
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL  # Default: Rachel

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_BUCKET=voicebrief-audio

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_DEFAULT_CHANNEL=#daily-briefings

# Google Docs Configuration (Optional - for Google Docs integration)
# Option 1: Service Account (for server-to-server access, requires sharing docs)
# GOOGLE_CREDENTIALS_FILE=/path/to/service-account.json
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}

# Option 2: OAuth2 (recommended - allows users to connect their own Google account)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://voicebrief.app/auth/google/callback

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BASE_URL=https://voicebrief.app
ENVIRONMENT=development

# Redis (for Celery background tasks)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here
